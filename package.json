{
  "name": "vscode-lint-arwaky",
  "displayName": "Lint Arwaky",
  "description": "AES architecture linting for Rust, Python, TypeScript projects",
  "version": "0.0.1",
  "publisher": "lint-arwaky",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [],
  "main": "./packages/dist/root_extension_entry.js",
  "contributes": {
    "commands": [
      {
        "command": "lint-arwaky.scan",
        "title": "Lint Arwaky: Scan Workspace"
      },
      {
        "command": "lint-arwaky.scanFile",
        "title": "Lint Arwaky: Scan Active File"
      }
    ],
    "configuration": {
      "title": "Lint Arwaky",
      "properties": {
        "lint-arwaky.cliPath": {
          "type": "string",
          "default": "lint-arwaky-cli",
          "description": "Path to lint-arwaky-cli binary. Must be installed and available in PATH."
        },
        "lint-arwaky.format": {
          "type": "string",
          "default": "json",
          "enum": [
            "json",
            "text"
          ],
          "description": "Output format for CLI execution."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint packages --ext ts"
  },
  "workspaces": [
    "packages/shared",
    "packages/cli-scanner",
    "packages/vscode-ext"
  ],
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
