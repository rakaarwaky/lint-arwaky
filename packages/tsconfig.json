{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@lint-arwaky/shared/*": ["shared/src/*"],
      "@lint-arwaky/cli-scanner/*": ["cli-scanner/src/*"],
      "@lint-arwaky/vscode-ext/*": ["vscode-ext/src/*"]
    }
  },
  "include": [
    "root_extension_entry.ts",
    "shared/src/**/*",
    "cli-scanner/src/**/*",
    "vscode-ext/src/**/*"
  ]
}
