[Unit]
Description=Graph Loop Agent Pipeline (v2.0)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=raka
Group=raka
WorkingDirectory=/home/raka/mcp-arwaky/lint-arwaky
ExecStart=/bin/bash .agents/graph-loop/engine.sh start
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=graph-loop

# Environment
Environment=HOME=/home/raka
Environment=PATH=/home/raka/.cargo/bin:/home/raka/.local/bin:/usr/local/bin:/usr/bin:/bin

# Resource limits
MemoryMax=2G
CPUQuota=80%

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/raka/mcp-arwaky/lint-arwaky/.agents

[Install]
WantedBy=multi-user.target
