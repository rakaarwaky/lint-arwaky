{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "calculator-shared/*": ["./shared/*"],
      "calculator-addition/*": ["./addition/*"],
      "calculator-subtraction/*": ["./subtraction/*"],
      "calculator-multiplication/*": ["./multiplication/*"],
      "calculator-division/*": ["./division/*"],
      "calculator-cli/*": ["./cli/*"]
    }
  }
}
