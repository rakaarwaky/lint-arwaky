{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "calculator-shared/*": ["./shared/*"]
    }
  },
  "include": ["src/**/*.ts", "shared/src/**/*.ts", "addition/src/**/*.ts", "subtraction/src/**/*.ts", "multiplication/src/**/*.ts", "division/src/**/*.ts", "cli/src/**/*.ts"]
}
