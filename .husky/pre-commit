#!/usr/bin/env bash
# Lint Arwaky Pre-Commit Hook — self-lint only, 0 violations to pass

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"
LOCAL_BIN="$REPO_ROOT/target/release/lint-arwaky-cli"

if [ -x "$LOCAL_BIN" ]; then
    LINT_CMD="$LOCAL_BIN"
else
    LINT_CMD="lint-arwaky-cli"
fi

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  lint-arwaky self-scan (0 violations required)"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

OUTPUT=$("$LINT_CMD" scan "$REPO_ROOT" 2>&1) || true
echo "$OUTPUT"

VIOLATIONS=$(echo "$OUTPUT" | grep -oP 'Total:\s*\K[0-9]+' || echo "0")

if [ "$VIOLATIONS" -eq 0 ]; then
    echo "✅ 0 violations — commit allowed."
    exit 0
else
    echo ""
    echo "❌ $VIOLATIONS violations found — commit BLOCKED."
    exit 1
fi
