# Repowise ignore file — same exclusions as .repowise/config.yaml exclude_patterns.
# Fixture/test workspaces and non-production folders are excluded so code-health
# scores, dead-code findings, and MCP results reflect production code only.
# Mirrors .codacy.yaml exclusions and .repowise/bot.yaml ignore_paths.
workspaces-bad/
workspaces-good/
crates/*/tests/
scripts/
tools/
log/
target/
*.md

# Rust binary entry points (fn main, declared in Cargo.toml [[bin]]).
# repowise flags them as unreachable because they are never imported —
# that is their nature, not dead code (known repowise false positive).
crates/root_cli_main_entry.rs
crates/root_mcp_main_entry.rs
crates/root_tui_main_entry.rs

